#!/usr/bin/env python3
"""Pasteboard subcommand driver using gitlike-commands.

Dispatches to pb-* subcommands (pb-clean, pb-sort, pb-sed, etc.)
based on the first argument, using the gitlike-commands library.
"""

import logging
import sys

logger = logging.getLogger(__name__)


def main() -> None:
    """Dispatch to the appropriate pb-* subcommand."""
    logging.basicConfig(level=logging.WARNING, stream=sys.stderr)

    try:
        from gitlike_commands import subcommand_driver
    except ImportError:
        logger.error(
            "Missing dependency: gitlike-commands. Install with: pip install gitlike-commands"
        )
        sys.exit(1)

    subcommand_driver()


if __name__ == "__main__":
    main()
