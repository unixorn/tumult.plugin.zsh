#!/usr/bin/env python3
"""Battery charge indicator for shell prompts.

Reads battery state via ioreg and outputs a colored charge bar
suitable for embedding in zsh prompts.

Based on http://stevelosh.com/blog/2010/02/my-extravagant-zsh-prompt/
"""

import argparse
import logging
import math
import subprocess
import sys

# --- Constants ---

TOTAL_SLOTS = 10
GREEN_THRESHOLD = 6
YELLOW_THRESHOLD = 4

# Zsh prompt-wrapped ANSI colors (for embedding in PROMPT/RPROMPT)
ZSH_COLOR_GREEN = "%{\x1b[32m%}"
ZSH_COLOR_YELLOW = "%{\x1b[1;33m%}"
ZSH_COLOR_RED = "%{\x1b[31m%}"
ZSH_COLOR_RESET = "%{\x1b[00m%}"

# Raw ANSI colors (for standalone terminal use)
RAW_COLOR_GREEN = "\x1b[32m"
RAW_COLOR_YELLOW = "\x1b[1;33m"
RAW_COLOR_RED = "\x1b[31m"
RAW_COLOR_RESET = "\x1b[00m"

FILLED_CHAR = "\u25b8"
EMPTY_CHAR = "\u25b9"

logger = logging.getLogger(__name__)


def get_battery_info() -> tuple[float, float]:
    """Retrieve current and maximum battery capacity from ioreg.

    Returns:
        A tuple of (current_capacity, max_capacity) as floats.

    Raises:
        RuntimeError: If battery information cannot be parsed from ioreg output.
    """
    result = subprocess.run(
        ["ioreg", "-rc", "AppleSmartBattery"],
        capture_output=True,
        text=True,
        check=True,
    )

    lines = result.stdout.splitlines()

    # Match only top-level keys (space-padded " = ") to avoid nested BatteryData fields
    max_lines = [line for line in lines if '"MaxCapacity" = ' in line]
    cur_lines = [line for line in lines if '"CurrentCapacity" = ' in line]

    if not max_lines or not cur_lines:
        raise RuntimeError("Could not find battery capacity in ioreg output")

    max_capacity = float(max_lines[0].rpartition("=")[-1].strip())
    cur_capacity = float(cur_lines[0].rpartition("=")[-1].strip())

    if max_capacity <= 0:
        raise RuntimeError(f"Invalid MaxCapacity value: {max_capacity}")

    return cur_capacity, max_capacity


def calculate_charge(current: float = 0.0, maximum: float = 100.0) -> float:
    """Compute charge ratio, clamped to [0.0, 1.0].

    Args:
        current: Current battery capacity.
        maximum: Maximum battery capacity. Must be > 0.

    Returns:
        Charge ratio between 0.0 and 1.0.
    """
    if maximum <= 0:
        logger.warning("Maximum capacity is <= 0, returning 0.0")
        return 0.0

    ratio = current / maximum
    return max(0.0, min(1.0, ratio))


def format_battery_indicator(charge: float = 1.0, raw: bool = False) -> str:
    """Build the colored battery indicator string.

    Args:
        charge: Charge ratio between 0.0 and 1.0.
        raw: If True, use plain ANSI escapes instead of zsh prompt wrappers.

    Returns:
        A string containing the colored battery bar.
    """
    charge = max(0.0, min(1.0, charge))
    charge_threshold = int(math.ceil(10 * charge))
    filled_count = int(math.ceil(charge_threshold * (TOTAL_SLOTS / 10.0)))
    empty_count = TOTAL_SLOTS - filled_count

    filled = FILLED_CHAR * filled_count
    empty = EMPTY_CHAR * empty_count
    bar = filled + empty

    if raw:
        color_green, color_yellow, color_red, color_reset = (
            RAW_COLOR_GREEN, RAW_COLOR_YELLOW, RAW_COLOR_RED, RAW_COLOR_RESET
        )
    else:
        color_green, color_yellow, color_red, color_reset = (
            ZSH_COLOR_GREEN, ZSH_COLOR_YELLOW, ZSH_COLOR_RED, ZSH_COLOR_RESET
        )

    if filled_count > GREEN_THRESHOLD:
        color = color_green
    elif filled_count > YELLOW_THRESHOLD:
        color = color_yellow
    else:
        color = color_red

    return f"{color}{bar}{color_reset}"


def main() -> None:
    """Entry point: read battery state and write colored indicator to stdout."""
    parser = argparse.ArgumentParser(description="Display a colored battery charge indicator.")
    parser.add_argument(
        "--raw",
        action="store_true",
        default=False,
        help="Output plain ANSI colors instead of zsh prompt escapes (for standalone use)",
    )
    args = parser.parse_args()

    logging.basicConfig(level=logging.WARNING, stream=sys.stderr)

    try:
        current, maximum = get_battery_info()
    except (RuntimeError, subprocess.CalledProcessError, ValueError) as exc:
        logger.error("Failed to read battery info: %s", exc)
        sys.exit(1)

    charge = calculate_charge(current=current, maximum=maximum)
    indicator = format_battery_indicator(charge=charge, raw=args.raw)
    sys.stdout.write(indicator)
    if args.raw:
        sys.stdout.write("\n")


if __name__ == "__main__":
    main()
